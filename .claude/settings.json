{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-sync.mjs\"",
            "timeout": 45,
            "statusMessage": "Sincronizando com o GitHub..."
          }
        ]
      }
    ]
  }
}
